# ---- Banco ----
POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=oficina
POSTGRES_PORT=5432

# ---- Seguranca ----
# Em producao gere um segredo aleatorio com no minimo 64 caracteres.
APP_JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-64-caracteres-aleatorios

# ---- Usuario dono criado no primeiro start ----
APP_ADMIN_EMAIL=dono@oficina.local
APP_ADMIN_SENHA=123

# ---- Equipe criada no primeiro start ----
# Cria Delander e Gustavo (donos), a secretaria (recepcao) e Tonny e Kevim
# (mecanicos, com ficha de funcionario). Todos nascem com ESTA senha.
# Quem entra usa o apelido, nao o e-mail: tonny, kevim, delander, gustavo,
# secretaria. O e-mail continua funcionando para quem preferir.
# Vazio (o padrao) nao cria ninguem -- de proposito, para que um valor escrito
# no repositorio nunca vire a senha de producao.
# TROQUE a senha de cada um em Funcionarios depois do primeiro acesso.
APP_EQUIPE_SENHA_PADRAO=trocar-esta-senha

# ---- Dados de demonstracao (deixe false em producao) ----
APP_CARGA_DEMO=true

# ---- Tamanho minimo da senha ----
# Padrao seguro e 6. Deixe 3 apenas para testar; suba antes de usar de verdade.
APP_SENHA_MINIMA=3

# ---- Front ----
APP_CORS_ORIGENS=http://localhost:5173
APP_URL_PUBLICA=http://localhost:5173

# ---- Caminho da API no navegador (opcional, so no deploy) ----
# Vazio: o front chama /api e a Vercel reescreve para o Render. Funciona, mas
# cada chamada passa por um intermediario -- medido, 6,16 s contra 2,76 s.
# Preenchido com a URL do Render, o navegador fala direto com o backend.
# Para usar isso, APP_CORS_ORIGENS no Render precisa conter a origem do site.
# VITE_API_BASE=https://delander.onrender.com/api
